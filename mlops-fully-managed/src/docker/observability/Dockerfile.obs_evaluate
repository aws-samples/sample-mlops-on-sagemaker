FROM --platform=amd64 public.ecr.aws/lambda/python:3.12

COPY docker/observability/requirements_llm.txt ${LAMBDA_TASK_ROOT}/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY observability/lambda/llm_evaluation_lambda.py ${LAMBDA_TASK_ROOT}/handler.py

CMD ["handler.handler"]
